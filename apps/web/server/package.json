{
  "name": "@repo-safety/web-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repo-Safety web API and scan workers.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "dev": "REPO_SAFETY_INLINE_WORKER=1 node --watch dist/api.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@repo-safety/core": "workspace:*",
    "bullmq": "^6.7.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
